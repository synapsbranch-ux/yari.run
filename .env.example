YARI_ENV=dev
YARI_API_ADDR=:8080
# Origins per official docs: Vite dev server, Tauri 2 (macOS/Linux, Windows/Android, https scheme),
# Capacitor (iOS, Android default https scheme).
YARI_CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,https://localhost
DATABASE_URL=postgres://yari_app:change-me@localhost:5432/yari?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://yari:change-me@localhost:5432/yari?sslmode=disable
ZITADEL_ISSUER=http://localhost:8081
ZITADEL_CLIENT_ID=change-me
YARI_AGENT_RUNTIME=fake
YARI_AGENT_IMAGE=yari-agent:dev
YARI_AGENT_DEFAULT_MODEL=claude-sonnet-5-5
YARI_AGENT_SESSION_BUDGET_USD=2
YARI_SANDBOX_RUNTIME=runsc
YARI_MCP_URL=http://yari-mcp:8090/mcp
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=change-me
# Read only by the LiteLLM container, never by yari services or sandboxes:
ANTHROPIC_API_KEY=change-me
OPENAI_API_KEY=change-me
PUBLIC_API_URL=http://localhost:8080
PUBLIC_USE_FAKE_DATA=true
