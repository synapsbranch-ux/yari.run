{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "description": "The yari.run client: one Svelte codebase for web, desktop (Tauri) and mobile (Capacitor).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/svelte-query": "6.4.1",
    "@xyflow/svelte": "1.7.1",
    "@yari/api-client": "workspace:*",
    "@yari/fixtures": "workspace:*",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.70.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-svelte": "1.8.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
